{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Alien RL: Check setup",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "tools.check_setup", "--rl-smoke"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Alien RL: Bake ship textures",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "tools.bake_ship_textures"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Alien RL: Play ship deck",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-B", "-m", "app.play", "--scenario", "ship_deck_v1",
        "--scenario-seed", "${input:seed}", "--fps-limit", "60"
      ],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Alien RL: Run tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "pytest", "-q"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Alien RL: Play against trained Alien",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-B", "-m", "app.play", "--controller", "rl",
        "--run-dir", "${input:run}",
        "--checkpoint", "${input:run}/checkpoints/best.zip",
        "--sampling-seed", "310003", "--scenario-seed", "310002", "--fps-limit", "60"
      ],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "seed",
      "type": "promptString",
      "description": "Scenario seed: picks spawns, keycard and working exit",
      "default": "1"
    },
    {
      "id": "run",
      "type": "promptString",
      "description": "Run folder, e.g. trained/<name>/run or experiments/<name>/run",
      "default": "trained/ship_deck_full_v3_scratch_s3/run"
    }
  ]
}
