# Python and local development
.venv/
# Portable Python and git that tools/bootstrap.ps1 fetches when a machine lacks them.
/.python/
/.git-portable/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.env
.env.*
!.env.example
/configs/assets.local.json

# Purchased Stradex originals and derived textures must not enter a public repo.
/Flat/
/90s Style/
/Materials/
/*engine preview*.png
/GZDoom engine preview.png
/assets/stradex/

# Baked by tools.bake_ship_sounds from free recordings.
/assets/sounds/

# Baked by tools.bake_alien_sprites from a free CC0 model. The packed frames are kept,
# because baking them needs Blender.
/assets/alien/*
!/assets/alien/prepared/

# Baked by tools.bake_ship_sky from NASA maps. The baked sky is kept, because NASA's
# servers are not always reachable.
/assets/space/*
!/assets/space/ship_sky.npz

# Baked by tools.bake_ship_mood; the color grade's license forbids passing its files on.
/assets/mood/

# Generated experiments and machine-specific reports
/models/
/experiments/
/logs/
/output/
/tmp/

# Local project instructions
/AGENTS.md
/agent.md

# Local project specification
/plan.md

# Python build and test artifacts
build/
dist/
*.egg-info/
.eggs/
.tox/
.nox/
.mypy_cache/
.pytype/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local Claude Code settings and hooks
/.claude/

# Training output written outside experiments/
/runs/
/checkpoints/

# Editor backups and operating-system metadata
/.history/
.vscode/*.local.json
*.log
*.tmp
*.bak
*~
.DS_Store
Thumbs.db
Desktop.ini
